# Authentication and emergency controls
AUTH_BASE_URL=http://localhost:3000
AUTH_ACCESS_MIGRATION_ENABLED=false
AUTH_ADMIN_RECOVERY_TOKEN=
AUTH_ADMIN_REQUIRE_ACCESS=false
AUTH_IDENTITY_DIGEST_KEY=
AUTH_SESSION_TTL_SECONDS=2592000

# Enable only for local development
AUTH_DEV_ENABLED=true
AUTH_DEV_ALLOWED_HOSTS=

# Configure Google and Cloudflare Access; never commit real values
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_TURNSTILE_SITE_KEY=
AUTH_TURNSTILE_SECRET_KEY=
AUTH_CLOUDFLARE_ACCESS_TEAM_DOMAIN=
AUTH_CLOUDFLARE_ACCESS_AUD=

# Optional shared relay for live collaboration across Cloudflare or multiple processes
LIVE_RELAY_URL=
LIVE_RELAY_SECRET=

# Node adapter
STOWPLAN_SQLITE_PATH=data/stowplan.sqlite
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/j-256/stowplan
NEXT_PUBLIC_DOCS_URL=https://docs.stowplan.lasers.app/
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://stowplan.lasers.app/privacy
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=https://stowplan.lasers.app/terms
DOCS_APPLICATION_URL=https://stowplan.lasers.app
DOCS_PRIVACY_POLICY_URL=https://stowplan.lasers.app/privacy
DOCS_TERMS_OF_SERVICE_URL=https://stowplan.lasers.app/terms
DOCS_REPOSITORY_URL=https://github.com/j-256/stowplan
