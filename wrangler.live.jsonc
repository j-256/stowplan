{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stowplan-live",
  "main": "worker/live-relay.ts",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 250,
    "subrequests": 10
  },
  "ratelimits": [
    {
      "name": "LIVE_WORKSPACE_RATE_LIMITER",
      "namespace_id": "256004",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "live.stowplan.lasers.app",
      "custom_domain": true
    },
    {
      "pattern": "stowplan.lasers.app/v1/*",
      "zone_name": "lasers.app"
    }
  ],
  "compatibility_date": "2026-08-16",
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceLiveRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceLiveRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
