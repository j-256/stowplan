{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stowplan-live",
  "main": "worker/live-relay.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "live.stowplan.lasers.app",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-16",
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceLiveRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceLiveRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
