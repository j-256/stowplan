{
  "application": {
    "name": "Stowplan account identity",
    "type": "self_hosted",
    "domain": "stowplan.jklein.dev/account*",
    "destinations": [
      {
        "type": "public",
        "uri": "stowplan.jklein.dev/account*"
      },
      {
        "type": "public",
        "uri": "stowplan.jklein.dev/api/auth/access*"
      },
      {
        "type": "public",
        "uri": "stowplan.jklein.dev/admin*"
      },
      {
        "type": "public",
        "uri": "stowplan.jklein.dev/api/admin/*"
      }
    ],
    "session_duration": "24h",
    "app_launcher_visible": false,
    "auto_redirect_to_identity": true,
    "allow_authenticate_via_warp": false,
    "http_only_cookie_attribute": true,
    "options_preflight_bypass": false
  },
  "identity_provider": {
    "name": "One-time PIN",
    "type": "onetimepin"
  },
  "policy": {
    "name": "Allow configured Stowplan identities",
    "decision": "allow",
    "precedence": 1,
    "session_duration": "24h",
    "allowed_emails": []
  }
}
