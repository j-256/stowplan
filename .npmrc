audit=false
fund=false
update-notifier=false
cache=.sites-runtime/npm-cache
# The committed lockfile is written by npm 11 and its peer-dependency tree
# (notably the docsearch react 18 nesting under a react 19 project) is rejected
# by npm 10's stricter `npm ci`. Fail loudly on the wrong major instead of
# emitting a misleading "lockfile out of sync" error
engine-strict=true
