{
  "name": "stowplan",
  "version": "1.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "j-256 (James Klein)",
  "repository": {
    "type": "git",
    "url": "https://github.com/j-256/stowplan.git"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24 || 26",
    "npm": "11"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "predev": "bash scripts/dev-migrate.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "dev:next": "bash scripts/sites-env.sh -- next dev",
    "build": "bash scripts/build-verified.sh",
    "archive:sites": "bash scripts/sites-env.sh -- bash scripts/archive-sites-artifact.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:node": "node scripts/node-server.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:render",
    "test:unit": "vitest run",
    "test:live-relay": "vitest run --config vitest.live.config.ts",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:node-smoke": "node scripts/smoke-node.mjs",
    "test:next-dev-smoke": "node scripts/smoke-next-dev.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --max-warnings 0 --ignore-pattern dist --ignore-pattern coverage --ignore-pattern .next --ignore-pattern .open-next --ignore-pattern .sites-runtime --ignore-pattern .live-relay-dist --ignore-pattern docs/.vitepress/dist",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:check": "node scripts/check-docs-build.mjs",
    "docs:preview": "vitepress preview docs",
    "build:next": "bash scripts/sites-env.sh -- bash scripts/with-clean-next-output.sh -- next build",
    "build:cloudflare": "bash scripts/sites-env.sh -- opennextjs-cloudflare build",
    "build:live-relay": "wrangler deploy --dry-run --outdir .live-relay-dist --config wrangler.live.jsonc",
    "preview:cloudflare": "bash scripts/sites-env.sh -- opennextjs-cloudflare build && bash scripts/sites-env.sh -- opennextjs-cloudflare preview",
    "deploy:cloudflare": "bash scripts/sites-env.sh -- opennextjs-cloudflare build && bash scripts/sites-env.sh -- opennextjs-cloudflare deploy",
    "deploy:live-relay": "wrangler deploy --config wrangler.live.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.51.2",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vinext": "0.0.45",
    "vite": "8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fast-uri": "3.1.5",
    "glob@12.0.0": {
      "minimatch": "10.2.6"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@8.0.7": {
      "brace-expansion": "2.1.4"
    },
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "vitepress": {
      "vite": "6.4.3"
    }
  },
  "type": "module",
  "displayName": "Stowplan"
}
